{
  "name": "scholarflow",
  "version": "1.4.1",
  "description": "ScholarFlow - Literature Reading Tracker",
  "author": "ScholarFlow Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.scholarflow.desktop",
    "productName": "ScholarFlow",
    "copyright": "Copyright © 2026 ScholarFlow",
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/app.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "publish": {
        "provider": "github",
        "owner": "rdereq",
        "repo": "ScholarFlow"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/app.ico",
      "uninstallerIcon": "src/assets/app.ico",
      "installerHeaderIcon": "src/assets/app.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScholarFlow",
      "publish": {
        "provider": "github",
        "owner": "rdereq",
        "repo": "ScholarFlow"
      }
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3"
  }
}
